# Copy this file to .env and fill in ONE of the two LLM options below.
# If you leave both blank, ShadowTrace AI still runs completely: the AI
# Analyst falls back to an offline template mode that builds its answer
# directly and transparently from retrieved evidence and knowledge base
# sources (no language model in the loop, clearly labeled in the UI).

# ---- Option A: Anthropic ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Option B: Any OpenAI-compatible endpoint (OpenAI, or a self-hosted
# server implementing the /chat/completions API) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
